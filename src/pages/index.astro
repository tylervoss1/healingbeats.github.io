---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SelectButton from '../components/SelectButton.astro';
import Film from '../components/Film.astro';
import Deck from '../components/Deck.astro';
import RecordLabel from '../components/RecordLabel.astro';
import Icon from '../components/Icon.astro';
import StepList from '../components/StepList.astro';
import ProblemRows from '../components/ProblemRows.astro';
import CtaBand from '../components/CtaBand.astro';
import heroPhoto from '../assets/hero-knock.jpg';
import { HERO_VIDEO } from '../config';
import { url, ROUTES } from '../lib/url';
import { IMPACT, STARDUST, STUDENT, VISIT_STEPS, INCLUDED, THREE_PROBLEMS, HOSPITAL_LINE } from '../data/facts';
---
<Base
  title="Healing Beats Volunteers | Music and companionship at the hospital bedside"
  description="Healing Beats volunteers visit hospital patients, play the one song they ask for, and stay to hear the story it brings back. Bring the program to your hospital or volunteer."
>
  <!-- 1. Opening -->
  <section class="hero on-red">
    <div class="hero__photo">
      <Image
        src={heroPhoto}
        alt="A volunteer knocks on the door of a patient’s hospital room."
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 56.25em) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={62}
      />
      {HERO_VIDEO && <video class="hero__video" src={url(HERO_VIDEO)} poster={heroPhoto.src} autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video>}
    </div>
    <div class="hero__body wrap">
      <h1 class="hero__title">
        <span>Play their song.</span>
        <span class="lit">Stay for the story.</span>
      </h1>
      <p class="lede hero__lede">Healing Beats volunteers visit hospital patients, play the one song they ask for, and sit down to hear what it brings back.</p>
      <div class="hero__choices">
        <SelectButton href={url(ROUTES.hospitals)} label="Bring Healing Beats to your hospital" />
        <SelectButton href={url(ROUTES.volunteer)} label="Volunteer at the bedside" />
      </div>
    </div>
    <p class="hero__credit">Photo: UnityPoint Health</p>
  </section>

  <!-- 2. The film -->
  <section class="section on-ink film-sec">
    <div class="wrap film-sec__grid">
      <div class="stack film-sec__copy" data-reveal>
        <h2>See a visit <span class="lit">in 76 seconds.</span></h2>
        <p class="lede">Founder Jake Nitzkin, RN, on what happens when a patient hears a song they have not heard in fifteen years.</p>
      </div>
      <div class="film-sec__film" data-reveal="right">
        <Film />
      </div>
    </div>
  </section>

  <!-- 3. How a visit works -->
  <section class="section on-ivory visit" id="how-it-works">
    <div class="wrap">
      <h2 data-reveal>How a visit works</h2>
      <StepList steps={VISIT_STEPS} across />
    </div>
  </section>

  <!-- 4. Proof -->
  <section class="section on-red proof" id="stardust">
    <div class="wrap">
      <h2 class="figures proof__figures" data-reveal>
        {IMPACT.map((item) => (
          <span><b>{item.value}</b> {item.label}</span>
        ))}
      </h2>

      <div class="proof__story">
        <div class="proof__label" data-reveal="left">
          <RecordLabel
            song={STARDUST.song}
            artist={STARDUST.artist}
            note={`Requested ${STARDUST.year}`}
            rim="Requested at the bedside • Medical-surgical unit • Michigan"
          />
        </div>
        <figure class="proof__quote" data-reveal style="--i:1">
          <p class="lede">On a medical-surgical unit in Michigan, a patient asked for “Stardust.” It had been about fifteen years since they had heard it. They sang along.</p>
          <blockquote class="quote">“{STARDUST.quote}”</blockquote>
          <figcaption class="quote-by">Patient, {STARDUST.where}, {STARDUST.year}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 5. Who it helps -->
  <section class="section on-ivory helps">
    <div class="wrap">
      <h2 data-reveal>Three problems. <span class="lit">One program.</span></h2>
      <ProblemRows rows={THREE_PROBLEMS} />
    </div>
  </section>

  <!-- 6. For hospitals: words left, quote right -->
  <section class="section on-ink duo">
    <div class="wrap duo__grid">
      <div class="stack duo__words" data-reveal="left">
        <h2>Your program. <span class="lit">Your name on it.</span></h2>
        <p class="lede">Healing Beats is turnkey and white-label. It is built to feel like your hospital’s own initiative: low cost, high impact, and low burden on staff.</p>
        <ul class="ticks duo__list">
          {INCLUDED.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
        </ul>
        <p><a class="key" href={url(ROUTES.hospitals)}>Partner with us <Icon name="arrow" /></a></p>
      </div>
      <figure class="duo__voice" data-reveal="right" style="--i:1">
        <span class="strip-art duo__strip">
          <span class="strip">
            <span class="strip__line">A program offered by</span>
            <span class="strip__band">Your hospital</span>
            <span class="strip__line">to make your stay more comfortable</span>
          </span>
        </span>
        <blockquote class="quote">“{HOSPITAL_LINE}”</blockquote>
        <figcaption class="quote-by">What every volunteer tells every patient</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. For volunteers: quote left, words right -->
  <section class="section on-ivory duo duo--flip">
    <div class="wrap duo__grid">
      <div class="stack duo__words" data-reveal="right">
        <h2>You bring the speaker. <span class="lit">They pick the song.</span></h2>
        <p class="lede">You get step-by-step training, so you always know how to start. Students, pre-health or not, and community members are welcome.</p>
        <p><a class="key key--ink" href={url(ROUTES.volunteer)}>Volunteer <Icon name="arrow" /></a></p>
      </div>
      <figure class="duo__voice" data-reveal="left" style="--i:1">
        <p class="lede">Connecting with patients is what drives this volunteer’s interest in medicine, and their goal of becoming a physician who pairs compassion with clinical skill,</p>
        <blockquote class="quote">“{STUDENT.quote}”</blockquote>
        <figcaption class="quote-by">{STUDENT.who}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 8. Start a chapter: words left, record right -->
  <section class="section on-maroon duo">
    <div class="wrap duo__grid">
      <div class="stack duo__words" data-reveal="left">
        <h2>Bring it to <span class="lit">your local hospital.</span></h2>
        <p class="lede">No Healing Beats near you? A chapter is a group, often students, that partners with a nearby hospital to run the program there. We give you the training and the playbook.</p>
        <p><a class="key" href={url(ROUTES.chapter)}>Start a chapter <Icon name="arrow" /></a></p>
      </div>
      <div class="duo__deck" data-reveal="right" style="--i:1">
        <Deck label="Your hospital" sublabel="Side A" />
      </div>
    </div>
  </section>

  <!-- 9. Donate -->
  <CtaBand
    tone="yellow"
    center
    title="Keep the music playing."
    body="Your gift funds volunteer training and brings Healing Beats to new communities. We are a registered 501(c)(3) nonprofit, and donations are tax-deductible."
    href={url(ROUTES.donate)}
    label="Donate"
  />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: clip;
  }
  .hero__photo {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(27.5rem, 54svh);
    background: var(--red);
  }
  .hero__photo :global(img),
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.08);
  }
  .hero__video {
    position: absolute;
    inset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }
  /* Print screen and the melt into solid red */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(197 40 28 / 0) 30%, rgb(197 40 28 / 0.82) 68%, var(--red) 94%),
      radial-gradient(circle, rgb(94 15 12 / 0.55) 0.9px, transparent 1.3px) 0 0 / 5px 5px;
  }
  .hero__body {
    position: relative;
    padding-top: min(13.5rem, 25svh);
    padding-bottom: var(--s-6);
  }
  .hero__title {
    font-size: var(--text-hero);
    line-height: 0.88;
  }
  .hero__title span {
    display: block;
  }
  .hero__lede {
    margin-top: var(--s-4);
  }
  .hero__choices {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .hero__credit {
    position: absolute;
    top: 0.6rem;
    right: var(--gutter);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title span,
    .hero__lede,
    .hero__choices {
      animation: rise 0.9s var(--ease-out) backwards;
    }
    .hero__title span:nth-child(2) { animation-delay: 0.1s; }
    .hero__lede { animation-delay: 0.2s; }
    .hero__choices { animation-delay: 0.3s; }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @media (min-width: 56.25em) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      min-height: min(47rem, calc(100svh - var(--header-h) - 3.5rem));
    }
    .hero__photo {
      position: relative;
      grid-column: 2;
      grid-row: 1;
      height: auto;
    }
    .hero__photo :global(img) {
      position: absolute;
      inset: 0;
      object-position: 38% 30%;
    }
    .hero__photo::after {
      background:
        linear-gradient(to right, var(--red) 0, rgb(197 40 28 / 0) 34%),
        radial-gradient(circle, rgb(94 15 12 / 0.55) 1px, transparent 1.5px) 0 0 / 6px 6px;
    }
    .hero__body {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      width: auto;
      margin: 0;
      padding: var(--s-7) var(--s-6) var(--s-7) max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    }
    .hero__choices {
      grid-template-columns: 1fr 1fr;
      max-width: 44rem;
    }
    .hero__choices :global(.select__label) {
      font-size: 1.5rem;
    }
    .hero__credit {
      top: auto;
      bottom: 0.75rem;
    }
  }
  @media (min-width: 75em) {
    .hero {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
    .hero__title {
      font-size: 5.5rem;
    }
    .hero__title span {
      white-space: nowrap;
    }
  }

  /* ---------- The film ---------- */
  .film-sec__grid {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 56.25em) {
    .film-sec__grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      align-items: center;
      gap: var(--s-8);
    }
  }

  /* ---------- Proof ---------- */
  .proof__story {
    margin-top: var(--s-7);
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .proof__label {
    width: min(100%, 21rem);
  }
  .proof__quote .quote {
    margin-top: var(--s-5);
    max-width: 18ch;
  }
  @media (min-width: 56.25em) {
    .proof__figures {
      font-size: var(--text-hero);
    }
    .proof__story {
      grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-8);
    }
    .proof__label {
      width: 100%;
    }
  }

  /* ---------- Hospitals, volunteers, chapter: one alternating pattern ---------- */
  .duo__grid {
    display: grid;
    gap: var(--s-7);
  }
  .duo__list {
    margin-block: var(--s-5);
  }
  .duo__strip {
    display: block;
    max-width: 19rem;
    margin-bottom: var(--s-6);
    transform: rotate(-2.5deg);
  }
  .duo__strip .strip__band {
    font-size: 2rem;
  }
  .duo__voice .lede + .quote {
    margin-top: var(--s-4);
  }
  .duo__deck {
    display: grid;
    justify-items: center;
  }
  @media (min-width: 56.25em) {
    .duo__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--s-8);
    }
    .duo--flip .duo__words {
      order: 2;
    }
    .duo__deck {
      justify-items: end;
    }
  }
</style>
