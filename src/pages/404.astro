---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url, ROUTES } from '../lib/url';
---
<Base title="Page not found" description="That page is not on the jukebox. Head back to the Healing Beats home page.">
  <section class="section on-red">
    <div class="wrap stack">
      <h1>That one is <span class="lit">not on the jukebox.</span></h1>
      <p class="lede">The page you asked for is not here. Try the home page.</p>
      <p><a class="key" href={url(ROUTES.home)}>Home <Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>
