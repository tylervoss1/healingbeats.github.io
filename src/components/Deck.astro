---
/**
 * The record deck. As the page scrolls the record turns and the tonearm
 * swings in. Pressing play drops the needle and loads the film in place.
 * No video or third-party request happens before that press.
 */
import Icon from './Icon.astro';
import { SITE } from '../config';
const watchUrl = `https://www.youtube.com/watch?v=${SITE.youtubeId}`;
---
<figure class="deck-wrap">
  <div class="deck" data-progress data-video={SITE.youtubeId}>
    <div class="deck__record" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="37" fill="#ffc531" />
        <circle cx="100" cy="100" r="33.5" fill="none" stroke="#1a1210" stroke-width="0.8" />
        <path id="deck-arc" d="M73 100a27 27 0 1 1 54 0" fill="none" />
        <text font-size="6.4" font-weight="800" letter-spacing="1" fill="#1a1210" style="font-stretch:75%">
          <textPath href="#deck-arc" startOffset="50%" text-anchor="middle">HEALING BEATS VOLUNTEERS</textPath>
        </text>
        <text x="100" y="118" text-anchor="middle" font-size="8.5" font-weight="900" fill="#1a1210" style="font-stretch:68%">STARDUST</text>
        <text x="100" y="126" text-anchor="middle" font-size="4.6" font-weight="600" fill="#1a1210">Nat King Cole</text>
        <circle cx="100" cy="100" r="5" fill="#1a1210" />
      </svg>
    </div>
    <div class="deck__sheen" aria-hidden="true"></div>
    <svg class="deck__arm" viewBox="0 0 60 300" aria-hidden="true">
      <rect x="21" y="2" width="18" height="34" rx="4" fill="#fff6e0" />
      <circle cx="30" cy="62" r="24" fill="#5e0f0c" />
      <circle cx="30" cy="62" r="13" fill="#fff6e0" />
      <path d="M30 62V246" stroke="#fff6e0" stroke-width="7" stroke-linecap="round" />
      <rect x="15" y="236" width="30" height="52" rx="5" fill="#ffc531" />
      <rect x="26" y="288" width="8" height="8" fill="#1a1210" />
    </svg>
    <a class="deck__play" href={watchUrl} data-play>
      <span class="deck__play-key"><Icon name="play" /></span>
      <span class="deck__play-text">
        <strong>Play the film</strong>
        <span>76 seconds, with sound</span>
      </span>
    </a>
    <div class="deck__screen" hidden></div>
  </div>
  <figcaption class="deck__caption">Jake Nitzkin, RN, on what a song can bring back. Film: UnityPoint Health.</figcaption>
</figure>

<style>
  .deck-wrap {
    width: 100%;
    max-width: 34rem;
  }
  .deck {
    --p: 0.5;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--red);
    box-shadow: 0 6px 0 var(--maroon), 0 30px 40px -24px rgb(26 18 16 / 0.55);
  }
  .deck__record,
  .deck__sheen {
    position: absolute;
    left: 6%;
    top: 7%;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .deck__record {
    background: repeating-radial-gradient(circle, #1a1210 0 2px, #33282a 2px 3px);
    box-shadow: 0 10px 18px -8px rgb(26 18 16 / 0.7);
    transform: rotate(calc(var(--p) * 900deg));
    will-change: transform;
  }
  .deck__record svg {
    width: 100%;
    height: 100%;
  }
  .deck__sheen {
    background: conic-gradient(from 20deg, transparent 0 8%, rgb(255 246 224 / 0.16) 14%, transparent 22% 55%, rgb(255 246 224 / 0.1) 63%, transparent 72%);
    -webkit-mask: radial-gradient(circle, transparent 0 38%, #000 38.5%);
    mask: radial-gradient(circle, transparent 0 38%, #000 38.5%);
    pointer-events: none;
  }
  .deck__arm {
    position: absolute;
    right: 5.5%;
    top: 3%;
    width: 13%;
    height: 65%;
    transform-origin: 50% 20.7%;
    transform: rotate(calc(4deg + clamp(0, (var(--p) - 0.18) * 2.6, 1) * 21deg));
    will-change: transform;
    filter: drop-shadow(0 8px 6px rgb(26 18 16 / 0.35));
  }
  .deck__play {
    position: absolute;
    left: 5%;
    bottom: 5%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 2rem;
    background: var(--ink);
    color: var(--ivory);
    text-decoration: none;
    --focus: var(--yellow);
    transition: transform 0.2s var(--ease-out);
  }
  .deck__play:hover {
    transform: translateY(-2px);
  }
  .deck__play-key {
    display: grid;
    place-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
  }
  .deck__play-key :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
    margin-left: 2px;
  }
  .deck__play-text {
    display: grid;
    line-height: 1.15;
  }
  .deck__play-text strong {
    font-stretch: 75%;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .deck__play-text span {
    font-size: var(--text-sm);
  }
  .deck__screen {
    position: absolute;
    inset: 0;
    background: var(--ink);
  }
  .deck__screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .deck.is-playing {
    aspect-ratio: 16 / 9;
  }
  .deck.is-playing > :not(.deck__screen) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .deck__record {
      transform: none;
    }
  }
  .deck__caption {
    margin-top: var(--s-4);
    font-size: var(--text-sm);
  }
</style>

<script>
  for (const deck of document.querySelectorAll<HTMLElement>('.deck[data-video]')) {
    const play = deck.querySelector<HTMLAnchorElement>('[data-play]');
    const screen = deck.querySelector<HTMLElement>('.deck__screen');
    if (!play || !screen) continue;
    play.setAttribute('role', 'button');
    play.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${deck.dataset.video}?autoplay=1&rel=0`;
      frame.title = 'Healing Beats at UnityPoint Health (video)';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      screen.append(frame);
      screen.hidden = false;
      deck.classList.add('is-playing');
      frame.focus();
    });
  }
</script>
