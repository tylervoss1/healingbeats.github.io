---
/**
 * The record deck: a decorative record and tonearm. As the page scrolls the
 * record turns and the arm swings in. It carries no content of its own.
 */
interface Props {
  /** The words on the record's label. */
  label?: string;
  sublabel?: string;
}
const { label = 'Your hospital', sublabel = 'Side A' } = Astro.props;
---
<div class="deck" data-progress aria-hidden="true">
  <div class="deck__record">
    <svg viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="37" fill="#ffc531" />
      <circle cx="100" cy="100" r="33.5" fill="none" stroke="#1a1210" stroke-width="0.8" />
      <path id="deck-arc" d="M73 100a27 27 0 1 1 54 0" fill="none" />
      <text font-size="6.4" font-weight="800" letter-spacing="1" fill="#1a1210" style="font-stretch:75%">
        <textPath href="#deck-arc" startOffset="50%" text-anchor="middle">HEALING BEATS VOLUNTEERS</textPath>
      </text>
      <text x="100" y="119" text-anchor="middle" font-size="8.5" font-weight="900" fill="#1a1210" style="font-stretch:68%;text-transform:uppercase">{label}</text>
      <text x="100" y="127" text-anchor="middle" font-size="4.6" font-weight="600" fill="#1a1210">{sublabel}</text>
      <circle cx="100" cy="100" r="5" fill="#1a1210" />
    </svg>
  </div>
  <div class="deck__sheen"></div>
  <svg class="deck__arm" viewBox="0 0 60 300">
    <rect x="21" y="2" width="18" height="34" rx="4" fill="#fff6e0" />
    <circle cx="30" cy="62" r="24" fill="#5e0f0c" />
    <circle cx="30" cy="62" r="13" fill="#fff6e0" />
    <path d="M30 62V246" stroke="#fff6e0" stroke-width="7" stroke-linecap="round" />
    <rect x="15" y="236" width="30" height="52" rx="5" fill="#ffc531" />
    <rect x="26" y="288" width="8" height="8" fill="#1a1210" />
  </svg>
</div>

<style>
  .deck {
    --p: 0.5;
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--red);
    box-shadow: 0 6px 0 var(--ink), 0 30px 40px -24px rgb(26 18 16 / 0.6);
  }
  .deck__record,
  .deck__sheen {
    position: absolute;
    left: 6%;
    top: 11%;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .deck__record {
    background: repeating-radial-gradient(circle, var(--ink) 0 2px, var(--groove) 2px 3px);
    box-shadow: 0 10px 18px -8px rgb(26 18 16 / 0.7);
    transform: rotate(calc(var(--p) * 900deg));
    will-change: transform;
  }
  .deck__record svg {
    width: 100%;
    height: 100%;
  }
  .deck__sheen {
    background: conic-gradient(from 20deg, transparent 0 8%, rgb(255 246 224 / 0.16) 14%, transparent 22% 55%, rgb(255 246 224 / 0.1) 63%, transparent 72%);
    -webkit-mask: radial-gradient(circle, transparent 0 38%, #000 38.5%);
    mask: radial-gradient(circle, transparent 0 38%, #000 38.5%);
  }
  .deck__arm {
    position: absolute;
    right: 5.5%;
    top: 5%;
    width: 13%;
    height: 65%;
    transform-origin: 50% 20.7%;
    transform: rotate(calc(4deg + clamp(0, (var(--p) - 0.18) * 2.6, 1) * 21deg));
    will-change: transform;
    filter: drop-shadow(0 8px 6px rgb(26 18 16 / 0.35));
  }
  @media (prefers-reduced-motion: reduce) {
    .deck__record {
      transform: none;
    }
  }
</style>
