---
/** Authored icon set: one 24px grid, 2.25px round strokes. */
interface Props {
  name: 'arrow' | 'play' | 'menu' | 'close' | 'mail' | 'check' | 'down';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  down: '<path d="M12 4v15M6 13l6 6 6-6"/>',
  play: '<path d="M8 5.5v13l11-6.5z" fill="currentColor"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  mail: '<path d="M3.5 6.5h17v11h-17zM4 7l8 6.5L20 7"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
};
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
