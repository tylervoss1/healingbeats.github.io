---
/**
 * The Healing Beats mark: a record with a speech-bubble tail.
 * Music and conversation in one shape. To replace the logo, edit this file.
 */
interface Props {
  /** Colour of the hole in the record; set it to the background behind the logo. */
  hole?: string;
  wordmark?: boolean;
}
const { hole = 'var(--bg, #c5281c)', wordmark = true } = Astro.props;
---
<span class="logo">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16 3A13 13 0 1 1 8.4 26.5L4 29l1.2-5.8A13 13 0 0 1 16 3z" />
    <circle cx="16" cy="16" r="4.4" fill={hole} />
    <circle cx="16" cy="16" r="1.3" fill="currentColor" />
  </svg>
  {wordmark && <span class="logo__word">Healing Beats</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .logo__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }
  .logo__word {
    font-stretch: 75%;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
