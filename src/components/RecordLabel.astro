---
/**
 * A round record label for one requested song. The rim text and the vinyl
 * edge turn as the page scrolls; the title in the middle stays upright.
 */
interface Props {
  song: string;
  artist: string;
  note: string;
  rim: string;
}
const { song, artist, note, rim } = Astro.props;
const rimText = `${rim} • ${rim} • `.toUpperCase();
---
<div class="rlabel" data-progress role="img" aria-label={`Record label: ${song} by ${artist}. ${note}.`}>
  <svg class="rlabel__spin" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="100" fill="#1a1210" />
    <g fill="none" stroke="#33282a" stroke-width="1.1">
      <circle cx="100" cy="100" r="97" /><circle cx="100" cy="100" r="94" /><circle cx="100" cy="100" r="91" /><circle cx="100" cy="100" r="88" />
    </g>
    <circle cx="100" cy="100" r="85" fill="#ffc531" />
    <circle cx="100" cy="100" r="66" fill="none" stroke="#1a1210" stroke-width="0.9" />
    <path id="rlabel-rim" d="M100 100m-72.5 0a72.5 72.5 0 1 1 145 0a72.5 72.5 0 1 1 -145 0" fill="none" />
    <text font-size="6.6" font-weight="800" fill="#1a1210" style="font-stretch:78%">
      <textPath href="#rlabel-rim" textLength="452" lengthAdjust="spacing">{rimText}</textPath>
    </text>
  </svg>
  <div class="rlabel__face" aria-hidden="true">
    <svg class="rlabel__mark" viewBox="0 0 32 32"><path fill="currentColor" d="M16 3A13 13 0 1 1 8.4 26.5L4 29l1.2-5.8A13 13 0 0 1 16 3z" /><circle cx="16" cy="16" r="4.4" fill="#ffc531" /><circle cx="16" cy="16" r="1.3" fill="currentColor" /></svg>
    <span class="rlabel__hole"></span>
    <strong>{song}</strong>
    <span>{artist}</span>
    <small>{note}</small>
  </div>
</div>

<style>
  .rlabel {
    --p: 0.5;
    position: relative;
    width: min(100%, 23rem);
    aspect-ratio: 1;
    border-radius: 50%;
    filter: drop-shadow(0 18px 22px rgb(26 18 16 / 0.45));
  }
  .rlabel__spin {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(calc(var(--p) * 300deg - 150deg));
    will-change: transform;
  }
  .rlabel__face {
    position: absolute;
    inset: 17%;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.1em;
    color: var(--ink);
    text-align: center;
    container-type: inline-size;
  }
  .rlabel__mark {
    width: 13cqw;
    height: 13cqw;
  }
  .rlabel__hole {
    width: 9cqw;
    height: 9cqw;
    margin-block: 4cqw;
    border-radius: 50%;
    background: var(--ink);
  }
  .rlabel__face strong {
    font-stretch: 62%;
    font-weight: 900;
    font-size: 21cqw;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .rlabel__face span:not(.rlabel__hole) {
    font-weight: 700;
    font-size: 7.6cqw;
    line-height: 1.2;
  }
  .rlabel__face small {
    font-family: var(--font-strip);
    font-weight: 700;
    font-size: 5.4cqw;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .rlabel__spin {
      transform: none;
    }
  }
</style>
