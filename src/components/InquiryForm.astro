---
/**
 * A form that posts to the single endpoint in src/config.ts.
 * Without JavaScript it is a normal form post. With it: inline errors,
 * a sending state, a success panel, and clear messages when the request
 * fails or the visitor is offline.
 */
import Icon from './Icon.astro';
import { FORM_ENDPOINT, SITE } from '../config';
interface Props {
  /** Shown in the email subject so the three forms can be told apart. */
  subject: string;
  submitLabel: string;
  successTitle: string;
  successBody: string;
}
const { subject, submitLabel, successTitle, successBody } = Astro.props;
const connected = FORM_ENDPOINT !== '';
---
<form class="form" method="post" action={connected ? FORM_ENDPOINT : undefined} data-form data-connected={connected ? 'true' : 'false'}>
  <input type="hidden" name="_subject" value={subject} />
  <p class="form__trap" aria-hidden="true">
    <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="form__fields">
    <slot />
  </div>

  <p class="form__status" data-status role="status" aria-live="polite"></p>

  <button class="key key--ink form__submit" type="submit" data-label={submitLabel}>
    <span data-submit-text>{submitLabel}</span>
    <Icon name="arrow" />
  </button>
  <p class="form__alt">Or email <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`}>{SITE.email}</a></p>
</form>

<div class="form-done" data-done hidden tabindex="-1">
  <span class="form-done__mark"><Icon name="check" /></span>
  <h3>{successTitle}</h3>
  <p>{successBody}</p>
</div>

<style>
  .form {
    display: grid;
    gap: var(--s-5);
  }
  .form__fields {
    display: grid;
    gap: var(--s-4);
  }
  .form__trap {
    position: absolute;
    left: -200vw;
    height: 0;
    overflow: hidden;
  }
  .form__status {
    padding: 0.8rem 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--yellow);
    font-weight: 600;
  }
  .form__status:empty {
    display: none;
  }
  .form__submit {
    justify-self: start;
    min-height: 3.5rem;
    padding-inline: 1.5rem;
    font-size: 1.15rem;
  }
  .form__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .form__alt {
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .form-done {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    border-block: 3px solid var(--ink);
    background: var(--yellow);
    color: var(--ink);
  }
  .form-done[hidden] {
    display: none;
  }
  .form-done__mark {
    display: grid;
    place-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--yellow);
  }
  .form-done__mark :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  @media (min-width: 40em) {
    .form__fields {
      grid-template-columns: 1fr 1fr;
    }
    .form__fields :global([data-wide]),
    .form__fields :global(.field:has(textarea)) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const messageFor = (input: HTMLInputElement | HTMLTextAreaElement): string => {
    const label = input.labels?.[0]?.firstChild?.textContent?.trim() ?? 'This field';
    const value = input.value.trim();
    if (input.required && !value) return `Please fill in “${label}”.`;
    if (input.type === 'email' && value && !EMAIL.test(value)) return 'That email looks incomplete. Check for a missing @ or ending.';
    return '';
  };

  const show = (input: HTMLInputElement | HTMLTextAreaElement, message: string) => {
    const slot = document.getElementById(`${input.id}-error`);
    if (slot) slot.textContent = message;
    if (message) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-form]')) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonText = form.querySelector<HTMLElement>('[data-submit-text]')!;
    const done = form.parentElement?.querySelector<HTMLElement>('[data-done]');
    const inputs = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field input, .field textarea')];

    // Re-check a field once it has shown an error, so the message clears as it is fixed.
    for (const input of inputs) {
      input.addEventListener('blur', () => show(input, messageFor(input)));
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) show(input, messageFor(input));
      });
    }

    const busy = (on: boolean) => {
      button.disabled = on;
      buttonText.textContent = on ? 'Sending…' : button.dataset.label ?? 'Send';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';

      let firstBad: HTMLElement | null = null;
      for (const input of inputs) {
        const message = messageFor(input);
        show(input, message);
        if (message && !firstBad) firstBad = input;
      }
      if (firstBad) {
        firstBad.focus();
        return;
      }

      if (form.dataset.connected !== 'true') {
        status.textContent = 'This form is not switched on yet. Please use the email address below for now.';
        return;
      }
      if (!navigator.onLine) {
        status.textContent = 'You seem to be offline. Your answers are still here: reconnect and press send again.';
        return;
      }

      busy(true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        if (done) {
          done.hidden = false;
          done.focus();
        }
      } catch (error) {
        status.textContent = navigator.onLine
          ? 'That did not send. Your answers are still here: try again, or use the email address below.'
          : 'The connection dropped. Your answers are still here: reconnect and press send again.';
      } finally {
        busy(false);
      }
    });
  }
</script>
