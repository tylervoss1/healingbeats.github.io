---
/** One labelled field with room for an inline error. */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'tel';
  required?: boolean;
  hint?: string;
  rows?: number;
  autocapitalize?: string;
}
const { name, label, type = 'text', autocomplete, inputmode, required = false, hint, rows = 4, autocapitalize } = Astro.props;
const id = `f-${name}`;
const describedBy = [hint ? `${id}-hint` : null, `${id}-error`].filter(Boolean).join(' ');
---
<div class="field" data-field>
  <label for={id}>
    {label}
    {!required && <span class="field__optional">optional</span>}
  </label>
  {hint && <p class="field__hint" id={`${id}-hint`}>{hint}</p>}
  {type === 'textarea' ? (
    <textarea id={id} name={name} rows={rows} required={required} autocomplete={autocomplete} aria-describedby={describedBy}></textarea>
  ) : (
    <input id={id} name={name} type={type} required={required} autocomplete={autocomplete} inputmode={inputmode} autocapitalize={autocapitalize} aria-describedby={describedBy} />
  )}
  <p class="field__error" id={`${id}-error`} aria-live="polite"></p>
</div>

<style>
  .field {
    display: grid;
    gap: 0.35rem;
  }
  label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    font-weight: 700;
  }
  .field__optional {
    font-size: var(--text-sm);
    font-weight: 400;
  }
  .field__hint {
    font-size: var(--text-sm);
  }
  input,
  textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.7rem 0.85rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font-size: 1.0625rem;
    caret-color: var(--red);
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  textarea {
    resize: vertical;
    line-height: 1.5;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-radius: var(--radius);
    box-shadow: 0 0 0 4px var(--yellow);
  }
  .field__error {
    min-height: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--red-deep);
  }
  .field__error:empty {
    display: none;
  }
  .field :global([aria-invalid='true']) {
    border-color: var(--red);
    background: var(--paper-error);
  }
</style>
