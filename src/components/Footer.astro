---
import Logo from './Logo.astro';
import { SITE } from '../config';
import { url, ROUTES, NAV } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="site-footer on-ink">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo hole="var(--ink)" />
      <p class="site-footer__mission">{SITE.mission}</p>
    </div>

    <nav id="footer-nav" aria-label="Footer">
      <ul class="site-footer__links">
        <li><a href={url(ROUTES.home)}>Home</a></li>
        {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        <li><a href={url(ROUTES.donate)}>Donate</a></li>
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p class="site-footer__label">Contact</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p>{SITE.founder}, founder</p>
    </div>
  </div>

  <div class="wrap site-footer__legal">
    <p>{SITE.name} is a registered 501(c)(3) nonprofit. EIN {SITE.ein}. Donations are tax-deductible.</p>
    <p>&copy; {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--s-8) var(--s-6);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-7);
  }
  .site-footer__mission {
    margin-top: var(--s-4);
    max-width: 22rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .site-footer__links {
    columns: 2;
    column-gap: var(--s-6);
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-stretch: 78%;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .site-footer__links a:hover {
    color: var(--yellow);
  }
  .site-footer__contact p + p {
    margin-top: var(--s-2);
  }
  .site-footer__label {
    font-weight: 700;
  }
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }
  .site-footer__legal {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: var(--s-2);
    font-size: var(--text-sm);
  }
  @media (min-width: 56.25em) {
    .site-footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
    .site-footer__legal {
      grid-template-columns: 1fr auto;
    }
  }
</style>
